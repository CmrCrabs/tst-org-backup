{
    "manifest_version": 3,
    "name": "tst-org-backup",
    "version": "1.0",

    "content_security_policy": {
        "extension_pages": "script-src 'self'"
    },
    "host_permissions": [
        "http://localhost/8080/tst-org-backup/read-file",
        "http://localhost/8080/tst-org-backup/read-timestamp",
        "http://localhost/8080/tst-org-backup/write"
    ],

    "permissions": ["storage"],

    "description": "automatically backup TST tabs state to human-readable org-mode, and sync the current TST State to be that of the local file.",

    "icons": {
        "48": "icons/tst-org-backup-48.png",
        "96": "icons/tst-org-backup-96.png"
    },

    "action": {
        "default_icon": {
            "48": "icons/tst-org-backup-48.png",
            "96": "icons/tst-org-backup-96.png"
        },
        "default_popup": "popup/tst-org-backup.html"
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "tst-org-backup@zfazam",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "background": {
        "scripts": ["tst-org-backup.js"],
        "type": "module"
    }
}
